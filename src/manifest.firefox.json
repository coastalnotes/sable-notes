{
  "manifest_version": 3,
  "name": "Sable Notes",
  "version": "0.1.0",
  "description": "Sable Notes: Sleek, local-first Markdown notes with Obsidian-compatible [[wiki-links]], #tags, and folder sync.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sable-markdown-notes@example.com",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quick capture note",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_title": "Sable Notes",
    "default_panel": "sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "quick-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Quick-capture a note"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open quick capture popup"
    }
  },
  "permissions": ["storage", "contextMenus", "alarms", "tabs"],
  "host_permissions": []
}
